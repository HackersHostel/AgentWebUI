# AgentWebUI Lite reads this file at startup. Copy it to .env and keep what you use.
# A value may name a variable from your shell as ${NAME}, so keys need not be written here.

# --- Server ---
HOST=127.0.0.1               # 0.0.0.0 to reach it from other machines; then PASSWORD is required
PORT=3000
# PASSWORD=                  # when set, the page asks for it once per browser
# USER_NAME=                 # used in the greeting
DATA_DIR=data                # chats.db lives here
# SYSTEM_PROMPT=             # sent first in every model chat
# WORKSPACE_DIR=~/code       # default folder for agent chats (else your home folder)
# AGENT_IDLE_MINUTES=10      # an agent process with nothing to do stops after this long
# UPLOAD_MB=25               # the largest file you can attach or upload
# RICH_REPLIES=true          # tell models and agents they can show pickers, images and files in the chat

# --- Files and Git ---
# FILES_ROOTS=~/code,~/notes # what the Files page shows and where agent chats may work (comma-separated).
#                            # Unset: WORKSPACE_DIR and each agent's folder.

# --- On a server ---
# TRUST_PROXY=true           # behind Caddy or nginx: trust X-Forwarded-Proto/For (secure cookie, login limits)
# NOTIFY_WEBHOOK=            # POSTed {"text", "event", "chat", "title"} when a reply finishes, fails or waits for you

# --- Your brand ---
# BRAND_NAME=AgentWebUI      # page title, sidebar, sign in, installed app
# BRAND_LOGO=                # a file path or an https:// URL (SVG or PNG); else the built-in logo
# BRAND_GREETING=            # replaces "Good morning" on the home screen
# BRAND_THEME=dark           # where a new browser starts: dark, light, system, graphite, terminal, paper, hc
# BRAND_ACCENT=#6e56cf       # a hex color; a new browser starts on a custom theme with it

# --- Models: any OpenAI-compatible API ---
# PROVIDER_<ID>_URL    base URL that has /models and /chat/completions
# PROVIDER_<ID>_KEY    API key, sent as a Bearer token (leave out for local servers)
# PROVIDER_<ID>_MODELS comma-separated; leave out to list what the server reports
# PROVIDER_<ID>_NAME   shown in the model picker

# PROVIDER_OPENAI_URL=https://api.openai.com/v1
# PROVIDER_OPENAI_KEY=${OPENAI_API_KEY}
# PROVIDER_OPENAI_NAME=OpenAI

# PROVIDER_OPENROUTER_URL=https://openrouter.ai/api/v1
# PROVIDER_OPENROUTER_KEY=${OPENROUTER_API_KEY}
# PROVIDER_OPENROUTER_NAME=OpenRouter

# PROVIDER_OLLAMA_URL=http://127.0.0.1:11434/v1
# PROVIDER_OLLAMA_NAME=Ollama

# PROVIDER_LMSTUDIO_URL=http://127.0.0.1:1234/v1
# PROVIDER_LMSTUDIO_NAME=LM Studio

# --- Agents: anything that speaks the Agent Client Protocol (ACP) over stdio ---
# AGENT_<ID>_COMMAND   the command line that starts the agent in ACP mode
# AGENT_<ID>_NAME      shown in the picker
# AGENT_<ID>_CWD       default folder for its chats (else WORKSPACE_DIR)
# AGENT_<ID>_MODEL     the model new chats start on until the browser remembers a choice (e.g. sonnet, opus)
# The agent runs as you, with this server's environment, so its own sign-in and API keys apply.

# AGENT_CLAUDE_COMMAND=npx -y @agentclientprotocol/claude-agent-acp
# AGENT_CLAUDE_NAME=Claude Code
# AGENT_CLAUDE_MODEL=sonnet

# AGENT_CODEX_COMMAND=npx -y @agentclientprotocol/codex-acp
# AGENT_CODEX_NAME=Codex

# AGENT_HERMES_COMMAND=hermes acp
# AGENT_HERMES_NAME=Hermes

# AGENT_PI_COMMAND=npx -y pi-acp      # needs pi on your PATH (npm i -g @earendil-works/pi-coding-agent)
# AGENT_PI_NAME=Pi

# AGENT_GEMINI_COMMAND=gemini --experimental-acp   # the flag has changed between versions: see gemini --help
# AGENT_GEMINI_NAME=Gemini CLI

# AGENT_OPENCODE_COMMAND=opencode acp
# AGENT_OPENCODE_NAME=OpenCode
